---
import { components } from '../data/components';

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;

const categories = [
  {
    name: "Getting Started",
    items: [
      { title: "Introduction", href: "/docs", badge: "Overview" },
      { title: "Tailwind CSS v4", href: "/docs#tailwind-v4", badge: "V4" }
    ]
  },
  {
    name: "Core Primitives",
    items: components.filter(c => c.category === "Core Primitives").map(c => ({ title: c.title, href: `/docs/components/${c.slug}`, slug: c.slug }))
  },
  {
    name: "Forms & Inputs",
    items: components.filter(c => c.category === "Forms & Inputs").map(c => ({ title: c.title, href: `/docs/components/${c.slug}`, slug: c.slug }))
  },
  {
    name: "Overlays & Modals",
    items: components.filter(c => c.category === "Overlays & Modals").map(c => ({ title: c.title, href: `/docs/components/${c.slug}`, slug: c.slug }))
  },
  {
    name: "Motion & Effects",
    items: components.filter(c => c.category === "Motion & Effects").map(c => ({ title: c.title, href: `/docs/components/${c.slug}`, slug: c.slug, badge: "Glow" }))
  },
  {
    name: "Layout & Surfaces",
    items: components.filter(c => c.category === "Layout & Navigation").map(c => ({ title: c.title, href: `/docs/components/${c.slug}`, slug: c.slug }))
  }
];
---

<aside 
  id="docs-sidebar"
  class="fixed inset-y-0 left-0 z-30 w-64 pt-20 pb-8 px-4 bg-white dark:bg-zinc-950 border-r border-zinc-200 dark:border-zinc-800 overflow-y-auto transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out shrink-0"
>
  <nav class="space-y-6">
    {categories.map((cat) => (
      <div class="space-y-1.5">
        <h4 class="px-3 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
          {cat.name}
        </h4>
        <ul class="space-y-0.5">
          {cat.items.map((item) => {
            const isActive = activeSlug === item.slug || (!activeSlug && item.href === '/docs');
            return (
              <li>
                <a 
                  href={item.href} 
                  class={`flex items-center justify-between px-3 py-1.5 text-sm rounded-lg font-medium transition-colors ${
                    isActive 
                      ? "bg-zinc-100 dark:bg-zinc-900 text-blue-600 dark:text-blue-400 font-semibold" 
                      : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-900/50"
                  }`}
                >
                  <span>{item.title}</span>
                  {item.badge && (
                    <span class="text-[10px] px-1.5 py-0.2 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 font-mono">
                      {item.badge}
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<!-- Backdrop overlay for mobile drawer -->
<div 
  id="sidebar-backdrop" 
  class="fixed inset-0 z-20 bg-black/50 backdrop-blur-xs lg:hidden hidden transition-opacity"
></div>

<script is:inline>
  (function() {
    const toggleBtn = document.getElementById('mobile-sidebar-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');

    if (!toggleBtn || !sidebar || !backdrop) return;

    function openSidebar() {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
    }

    function closeSidebar() {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = !sidebar.classList.contains('-translate-x-full');
      if (isOpen) closeSidebar();
      else openSidebar();
    });

    backdrop.addEventListener('click', closeSidebar);
  })();
</script>
