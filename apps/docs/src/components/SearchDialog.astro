---
import { components } from '../data/components';
---

<!-- Search Trigger Dialog Backdrop Modal -->
<dialog 
  id="plain-search-dialog" 
  class="p-0 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs max-w-xl w-[calc(100vw-2rem)] text-zinc-900 dark:text-zinc-100 m-auto overflow-hidden"
>
  <div class="flex flex-col max-h-[80vh]">
    <!-- Search Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-zinc-200 dark:border-zinc-800 gap-3">
      <svg class="w-5 h-5 text-zinc-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        id="plain-search-input" 
        placeholder="Search documentation, components, tokens..." 
        autocomplete="off"
        class="w-full bg-transparent text-sm focus:outline-none placeholder:text-zinc-400"
      />
      <kbd class="hidden sm:inline-flex px-1.5 py-0.5 text-[10px] font-semibold text-zinc-500 bg-zinc-100 dark:bg-zinc-800 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 rounded shadow-xs">ESC</kbd>
    </div>

    <!-- Search Results List -->
    <div id="plain-search-results" class="p-2 overflow-y-auto space-y-1">
      <div class="px-3 py-2 text-xs font-semibold text-zinc-400 uppercase tracking-wider">Components</div>
      {components.map((c) => (
        <a 
          href={`/docs/components/${c.slug}`} 
          class="search-item flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800/70 transition-colors group cursor-pointer"
          data-title={c.title.toLowerCase()}
          data-desc={c.description.toLowerCase()}
          data-category={c.category.toLowerCase()}
        >
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-xs font-mono text-zinc-500 group-hover:text-blue-500 group-hover:bg-blue-50 dark:group-hover:bg-blue-950/40 transition-colors">
              #
            </span>
            <div>
              <div class="text-sm font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{c.title}</div>
              <div class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">{c.description}</div>
            </div>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 text-[11px]">{c.category}</span>
        </a>
      ))}
      
      <div class="px-3 py-2 text-xs font-semibold text-zinc-400 uppercase tracking-wider mt-2">Getting Started</div>
      <a href="/docs" class="search-item flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800/70 transition-colors group" data-title="getting started installation introduction overview" data-desc="overview and setup">
        <span class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-xs text-zinc-500">📖</span>
        <div>
          <div class="text-sm font-medium">Getting Started & Tailwind v4 Setup</div>
          <div class="text-xs text-zinc-500">Quick start guide and architecture overview</div>
        </div>
      </a>
    </div>

    <!-- Footer -->
    <div class="px-4 py-2.5 border-t border-zinc-200 dark:border-zinc-800 text-[11px] text-zinc-400 flex items-center justify-between bg-zinc-50 dark:bg-zinc-950/50">
      <div class="flex items-center gap-2">
        <span>Navigate</span> <kbd class="px-1 py-0.5 bg-zinc-200 dark:bg-zinc-800 rounded">↑</kbd> <kbd class="px-1 py-0.5 bg-zinc-200 dark:bg-zinc-800 rounded">↓</kbd>
        <span>Select</span> <kbd class="px-1 py-0.5 bg-zinc-200 dark:bg-zinc-800 rounded">↵</kbd>
      </div>
      <span>Plain UI Search</span>
    </div>
  </div>
</dialog>

<script is:inline>
  (function() {
    const dialog = document.getElementById('plain-search-dialog');
    const input = document.getElementById('plain-search-input');
    const items = document.querySelectorAll('.search-item');

    if (!dialog || !input) return;

    // Keyboard shortcut to open (Cmd+K / Ctrl+K / /)
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openDialog();
      } else if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openDialog();
      }
    });

    // Close on backdrop click
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    function openDialog() {
      dialog.showModal();
      input.value = '';
      filterItems('');
      input.focus();
    }

    window.openPlainSearch = openDialog;

    // Live search filter
    input.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      filterItems(q);
    });

    function filterItems(query) {
      items.forEach(item => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const cat = item.getAttribute('data-category') || '';
        if (!query || title.includes(query) || desc.includes(query) || cat.includes(query)) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }
  })();
</script>
