---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { components } from '../data/components';
---

<BaseLayout title="Plain UI - Pure HTML + Tailwind CSS v4 Component Library">
  <Header />

  <!-- Hero Section -->
  <div class="relative overflow-hidden pt-20 pb-16 md:pt-28 md:pb-24 border-b border-zinc-200 dark:border-zinc-800">
    <!-- Background Glow Gradients -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-blue-600/20 via-indigo-600/15 to-purple-600/10 blur-[120px] pointer-events-none -z-10"></div>
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-6">
      
      <!-- Top Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100 dark:bg-zinc-900 border border-zinc-300/80 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Built for Tailwind CSS v4 & Modern Browsers</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-zinc-900 dark:text-white leading-[1.1]">
        Pure HTML & Tailwind v4 Primitives.<br />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-500 to-purple-500 bg-clip-text text-transparent">Zero Runtime. Copy & Paste.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Accessible, high-performance UI primitives crafted with pure HTML5, CSS Houdini, and Tailwind CSS v4. No heavy JS frameworks required.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a 
          href="/docs" 
          class="px-6 py-3.5 rounded-xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-semibold text-sm hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-all shadow-md hover:scale-[1.02] active:scale-[0.98]"
        >
          Explore Components →
        </a>

        <button 
          onclick="window.openPlainSearch && window.openPlainSearch()" 
          class="px-6 py-3.5 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white/60 dark:bg-zinc-900/60 font-semibold text-sm hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all shadow-xs hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
        >
          Search Library (⌘K)
        </button>
      </div>

      <!-- Quick CLI Snippet -->
      <div class="max-w-md mx-auto pt-6">
        <CodeBlock code="npx plain-ui add button dialog popover" lang="bash" filename="terminal" />
      </div>
    </div>
  </div>

  <!-- Component Showcase Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="space-y-3 text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight">10 Ready-to-use Primitives</h2>
      <p class="text-zinc-500 dark:text-zinc-400 max-w-xl mx-auto text-sm">
        Explore our growing catalog of light-DOM, zero-bundler components with instant live sandboxes and CodeMirror live editing.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {components.map((c) => (
        <a 
          href={`/docs/components/${c.slug}`}
          class="group relative flex flex-col justify-between p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all shadow-xs hover:shadow-lg"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {c.category}
              </span>
              <span class="text-xs font-mono text-zinc-400 group-hover:text-blue-500 transition-colors">
                View Docs →
              </span>
            </div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {c.title}
            </h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed">
              {c.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-4 mt-4 border-t border-zinc-100 dark:border-zinc-800">
            {c.badges.map(b => (
              <span class="text-[10px] px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800/80 text-zinc-500 font-mono">
                {b}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>

  <SearchDialog />
</BaseLayout>
