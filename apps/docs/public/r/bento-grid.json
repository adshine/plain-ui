{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "bento-grid",
  "type": "registry:ui",
  "title": "Bento Grid",
  "description": "Modern responsive bento grid layouts with dynamic aspect ratios and hover effects.",
  "version": "1.0.0",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [
