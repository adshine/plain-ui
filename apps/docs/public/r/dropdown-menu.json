  ],
  "files": [
    {
      "name": "dropdown-menu.html",
      "path": "ui/dropdown-menu.html",
      "content": "<!--\n  Plain UI - Dropdown Menu Component\n  Pure HTML5 / Tailwind v4 Zero-JS Dropdown Menu with Popover API & CSS Anchor Positioning\n-->\n\n<style>\n  /* Base Menu Popover Styling & Transition */\n  .plain-dropdown {\n    display: none;\n    margin: 0;\n    padding: 0.25rem;\n    border: 1px solid var(--border, #e2e8f0);\n    border-radius: 0.75rem;\n    background-color: var(--popover, #ffffff);\n    color: var(--popover-foreground, #0f172a);\n    box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);\n    opacity: 0;\n    transform: translateY(-4px) scale(0.98);\n    transition: \n      opacity 0.15s cubic-bezier(0.16, 1, 0.3, 1),\n      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),\n      display 0.15s allow-discrete,\n      overlay 0.15s allow-discrete;\n    overflow: visible;\n  }\n\n  .plain-dropdown:popover-open {\n    display: flex;\n    flex-direction: column;\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  @starting-style {\n    .plain-dropdown:popover-open {\n      opacity: 0;\n      transform: translateY(-4px) scale(0.98);\n    }\n  }\n\n  /* Anchor Positioning */\n  .dropdown-anchor {\n    position-anchor: var(--anchor-name);\n    position-area: bottom span-right;\n    margin-top: 0.35rem;\n    position-try-fallbacks: flip-block;\n  }\n\n  .submenu-anchor {\n    position-anchor: var(--sub-anchor);\n    position-area: right span-bottom;\n    margin-left: 0.35rem;\n    position-try-fallbacks: flip-inline;\n  }\n</style>\n\n<div class=\"space-y-12 p-6 max-w-5xl mx-auto font-sans\">\n  <!-- Section 1: Standard Dropdown Menu -->\n  <section class=\"space-y-4\">\n    <div>\n      <h3 class=\"text-lg font-semibold text-foreground\">Dropdown Menu</h3>\n      <p class=\"text-sm text-muted-foreground\">Zero-JS anchored menu featuring shortcut badges, icons, submenus, separators, and destructive actions.</p>\n    </div>\n\n    <!-- Menu Trigger Button -->\n    <button \n      type=\"button\"\n      popovertarget=\"main-dropdown-menu\"\n      style=\"anchor-name: --main-menu-trigger;\"\n      class=\"inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-foreground bg-background border border-input rounded-lg shadow-2xs hover:bg-accent active:scale-[0.98] transition-all cursor-pointer\"\n    >\n      <span>Options</span>\n      <svg class=\"w-4 h-4 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.5 8.25l-7.5 7.5-7.5-7.5\" />\n      </svg>\n    </button>\n\n    <!-- Anchored Dropdown Menu -->\n    <div \n      id=\"main-dropdown-menu\" \n      popover=\"auto\"\n      style=\"--anchor-name: --main-menu-trigger;\"\n      class=\"plain-dropdown dropdown-anchor w-56 font-sans\"\n    >\n      <!-- Menu Header -->\n      <div class=\"px-2.5 py-1.5 text-xs font-semibold text-muted-foreground\">\n        My Account\n      </div>\n\n      <!-- Item 1: Profile -->\n      <button \n        type=\"button\"\n        class=\"flex items-center justify-between w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors text-left\"\n      >\n        <span class=\"flex items-center gap-2\">\n          <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" /></svg>\n          Profile\n        </span>\n        <kbd class=\"px-1.5 py-0.5 text-[10px] font-mono bg-muted text-muted-foreground rounded border border-border/50\">⇧⌘P</kbd>\n      </button>\n\n      <!-- Item 2: Billing -->\n      <button \n        type=\"button\"\n        class=\"flex items-center justify-between w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors text-left\"\n      >\n        <span class=\"flex items-center gap-2\">\n          <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z\" /></svg>\n          Billing\n        </span>\n        <kbd class=\"px-1.5 py-0.5 text-[10px] font-mono bg-muted text-muted-foreground rounded border border-border/50\">⌘B</kbd>\n      </button>\n\n      <!-- Item 3: Settings -->\n      <button \n        type=\"button\"\n        class=\"flex items-center justify-between w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors text-left\"\n      >\n        <span class=\"flex items-center gap-2\">\n          <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" /></svg>\n          Settings\n        </span>\n        <kbd class=\"px-1.5 py-0.5 text-[10px] font-mono bg-muted text-muted-foreground rounded border border-border/50\">⌘S</kbd>\n      </button>\n\n      <!-- Submenu Trigger -->\n      <button \n        type=\"button\"\n        popovertarget=\"submenu-invite\"\n        style=\"anchor-name: --sub-invite-trigger;\"\n        class=\"flex items-center justify-between w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors text-left\"\n      >\n        <span class=\"flex items-center gap-2\">\n          <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z\" /></svg>\n          Invite Users\n        </span>\n        <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 4.5l7.5 7.5-7.5 7.5\" /></svg>\n      </button>\n\n      <!-- Separator -->\n      <div class=\"my-1 border-t border-border/60\" role=\"separator\"></div>\n\n      <!-- Destructive Item -->\n      <button \n        type=\"button\"\n        class=\"flex items-center justify-between w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-destructive hover:bg-destructive/10 cursor-pointer transition-colors text-left\"\n      >\n        <span class=\"flex items-center gap-2\">\n          <svg class=\"w-3.5 h-3.5 text-destructive\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\" /></svg>\n          Log out\n        </span>\n        <kbd class=\"px-1.5 py-0.5 text-[10px] font-mono bg-destructive/10 text-destructive rounded border border-destructive/20\">⇧⌘Q</kbd>\n      </button>\n    </div>\n\n    <!-- Nested Submenu -->\n    <div \n      id=\"submenu-invite\" \n      popover=\"auto\"\n      style=\"--sub-anchor: --sub-invite-trigger;\"\n      class=\"plain-dropdown submenu-anchor w-48 font-sans\"\n    >\n      <button type=\"button\" class=\"flex items-center gap-2 w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-foreground hover:bg-accent transition-colors text-left\">\n        <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" /></svg>\n        Email Invitation\n      </button>\n      <button type=\"button\" class=\"flex items-center gap-2 w-full px-2.5 py-1.5 text-xs font-medium rounded-md text-foreground hover:bg-accent transition-colors text-left\">\n        <svg class=\"w-3.5 h-3.5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1\" /></svg>\n        Copy Invite Link\n      </button>\n    </div>\n  </section>\n\n  <!-- Section 2: Checkbox & Radio Dropdown Menu -->\n  <section class=\"space-y-4\">\n    <div>\n      <h3 class=\"text-lg font-semibold text-foreground\">Selection & Filter Menu</h3>\n      <p class=\"text-sm text-muted-foreground\">Dropdown with zero-JS interactive checkboxes and radio options.</p>\n    </div>\n\n    <button \n      type=\"button\"\n      popovertarget=\"filter-dropdown-menu\"\n      style=\"anchor-name: --filter-trigger;\"\n      class=\"inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-foreground bg-background border border-input rounded-lg shadow-2xs hover:bg-accent cursor-pointer\"\n    >\n      <svg class=\"w-4 h-4 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z\" /></svg>\n      <span>Filter & View</span>\n    </button>\n\n    <div \n      id=\"filter-dropdown-menu\" \n      popover=\"auto\"\n      style=\"--anchor-name: --filter-trigger;\"\n      class=\"plain-dropdown dropdown-anchor w-60 font-sans p-2 space-y-2\"\n    >\n      <div class=\"text-xs font-semibold text-muted-foreground px-1\">Display Elements</div>\n      \n      <label class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-accent cursor-pointer text-xs font-medium text-foreground\">\n        <input type=\"checkbox\" checked class=\"rounded border-input text-primary focus:ring-primary h-3.5 w-3.5\" />\n        Show Status Bar\n      </label>\n\n      <label class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-accent cursor-pointer text-xs font-medium text-foreground\">\n        <input type=\"checkbox\" checked class=\"rounded border-input text-primary focus:ring-primary h-3.5 w-3.5\" />\n        Show Activity Bar\n      </label>\n\n      <div class=\"border-t border-border/60 my-1\"></div>\n      <div class=\"text-xs font-semibold text-muted-foreground px-1\">Sort By</div>\n\n      <label class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-accent cursor-pointer text-xs font-medium text-foreground\">\n        <input type=\"radio\" name=\"sort-choice\" checked class=\"text-primary focus:ring-primary h-3.5 w-3.5\" />\n        Recently Modified\n      </label>\n\n      <label class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-accent cursor-pointer text-xs font-medium text-foreground\">\n        <input type=\"radio\" name=\"sort-choice\" class=\"text-primary focus:ring-primary h-3.5 w-3.5\" />\n        Alphabetical (A-Z)\n      </label>\n    </div>\n  </section>\n</div>\n",
      "type": "registry:ui",
      "target": "src/components/ui/dropdown-menu.html"
    }
  ],
  "categories": [
    "navigation"
  ],
  "meta": {
    "zeroJs": true,
    "framework": "html5",
    "tailwind": "v4",
    "modernApis": [
      "popover='auto'",
      "anchor()",
      "position-anchor"
    ]
  }
}
