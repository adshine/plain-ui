{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-search",
  "type": "registry:ui",
  "title": "Search Input",
  "description": "Search inputs with quick-clear triggers, shortcut badges, and async loading spinners.",
  "version": "1.0.0",
